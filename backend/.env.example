# نمونه متغیرهای محیطی بک‌اند. برای اجرای محلی، این فایل را کپی کنید:
#   cp .env.example .env
# و مقداردهی کنید (نیاز به بسته python-dotenv اگر می‌خواهید خودکار لود شود؛
# در غیر این صورت این متغیرها را در محیط سیستم/venv خودتان export کنید).

# کلید امنیتی جنگو - برای پروداکشن حتماً یک مقدار تصادفی و طولانی بگذارید
DJANGO_SECRET_KEY=dev-secret-key-change-me

# 1 برای توسعه محلی، 0 برای پروداکشن
DJANGO_DEBUG=1

# هاست‌های مجاز، جدا شده با کاما (در Render نیازی نیست - از RENDER_EXTERNAL_HOSTNAME استفاده می‌شود)
DJANGO_ALLOWED_HOSTS=

# اگر خالی باشد از SQLite محلی استفاده می‌شود؛ روی Render به‌صورت خودکار ست می‌شود
DATABASE_URL=

# آدرس فرانت‌اند - برای CORS/CSRF (چند آدرس با کاما جدا شود)
FRONTEND_URL=http://localhost:8080

# لینک بازیابی رمز عبور که در ایمیل کاربر قرار می‌گیرد
FRONTEND_RESET_PASSWORD_URL=http://localhost:8080/reset-password

# ارسال واقعی ایمیل (اختیاری) - اگر خالی باشد، ایمیل‌ها فقط در کنسول چاپ می‌شوند
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
